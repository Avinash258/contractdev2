    "graphql": "^17.0.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@pact-foundation/pact": "^16.5.0",
    "axios": "^1.17.0",
    "babel-jest": "^30.4.1",
    "jest": "^30.4.2"
  }
}
