{
  "name": "contract-testing-graphql",
  "version": "1.0.0",
  "private": true,
  "description": "VaultMesh — GraphQL + gRPC app and contract tests",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node tests/contract/run-vaultmesh.js --no-start",
